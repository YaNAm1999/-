.container {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.checkin-header {
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  padding: 60rpx 30rpx;
  text-align: center;
}

.code-display {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.code-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.code-value {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 20rpx;
  margin-bottom: 15rpx;
}

.copy-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.checkin-status {
  margin-top: 20rpx;
}

.checkin-status .status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.checkin-status .status-text.present {
  color: #4CAF50;
}

.checkin-status .status-text.late {
  color: #FF9800;
}

.checkin-status .status-text.absent {
  color: #F44336;
}

.checkin-card {
  background: white;
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.card-content .hint {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.checkin-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4A90E2;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.checkin-btn::after {
  border: none;
}

.records-section, .absent-section {
  background: white;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.section-title .count {
  font-size: 24rpx;
  color: #999;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  border-radius: 10rpx;
}

.record-item.present {
  background: #E8F5E9;
}

.record-item.absent {
  background: #FFF3E0;
}

.record-info .name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.record-info .student-id {
  font-size: 22rpx;
  color: #999;
}

.record-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.record-status .status-tag {
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.record-status .status-tag.present {
  background: #4CAF50;
  color: white;
}

.record-status .status-tag.late {
  background: #FF9800;
  color: white;
}

.record-status .status-tag.absent {
  background: #F44336;
  color: white;
}

.record-status .time {
  font-size: 20rpx;
  color: #999;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #E5E5E5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.picker-value {
  padding: 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.location-btn {
  margin-top: 15rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4A90E2;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4A90E2;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-top: 30rpx;
}

.submit-btn::after {
  border: none;
}
