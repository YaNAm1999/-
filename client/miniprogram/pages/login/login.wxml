<view class="container">
  <view class="header">
    <text class="title">课堂教学辅助系统</text>
    <text class="subtitle">让教学更高效，让学习更便捷</text>
  </view>

  <view class="role-selector">
    <view class="role-btn {{role === 'student' ? 'active' : ''}}" data-role="student" bindtap="toggleRole">
      <text class="role-icon-text">👤</text>
      <text>我是学生</text>
    </view>
    <view class="role-btn {{role === 'teacher' ? 'active' : ''}}" data-role="teacher" bindtap="toggleRole">
      <text class="role-icon-text">👨‍🏫</text>
      <text>我是教师</text>
    </view>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入您的姓名" value="{{name}}" bindinput="onNameInput"/>
    </view>

    <view class="form-item" wx:if="{{role === 'student'}}">
      <text class="label">学号</text>
      <input class="input" type="number" placeholder="请输入您的学号" value="{{studentId}}" bindinput="onStudentIdInput"/>
    </view>

    <view class="form-item" wx:if="{{role === 'teacher'}}">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入您的手机号" value="{{phone}}" bindinput="onPhoneInput"/>
    </view>

    <button class="login-btn" bindtap="handleLogin" loading="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>
  </view>

  <view class="footer">
    <text>登录即表示同意</text>
    <text class="link">《用户协议》</text>
    <text>和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>