page {
  background-color: #F5F5F5;
}

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx 60rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 30rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.role-selector {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 40rpx;
  padding: 0 30rpx;
}

.role-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 50rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.role-btn.active {
  background: #4A90E2;
  color: white;
}

.role-icon-text {
  font-size: 64rpx;
  margin-bottom: 15rpx;
}

.form {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.form-item .input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #4A90E2;
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.login-btn::after {
  border: none;
}

.footer {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 30rpx;
}

.footer .link {
  color: #4A90E2;
}
