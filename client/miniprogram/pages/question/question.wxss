.container {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: white;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.action-btn {
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #4A90E2;
  color: white;
}

.filter-bar {
  padding: 20rpx 30rpx;
  background: white;
}

.filter-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.arrow {
  color: #CCC;
  font-size: 20rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
}

.question-list {
  padding: 20rpx;
}

.question-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.question-meta .student {
  font-size: 26rpx;
  color: #666;
}

.question-meta .course-tag {
  background: #4A90E2;
  color: white;
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-tag {
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-tag.answered {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-tag.pending {
  background: #FFF3E0;
  color: #FF9800;
}

.question-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.answer-section {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.answer-header .teacher {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: bold;
}

.answer-header .answer-time {
  font-size: 22rpx;
  color: #999;
}

.answer-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.answer-btn {
  margin-top: 20rpx;
  padding: 15rpx 30rpx;
  background: #4A90E2;
  color: white;
  border-radius: 30rpx;
  text-align: center;
  font-size: 26rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #E5E5E5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 50rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  padding: 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.question-preview {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
}

.question-preview .preview-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.question-preview .preview-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4A90E2;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-top: 30rpx;
}

.submit-btn::after {
  border: none;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
