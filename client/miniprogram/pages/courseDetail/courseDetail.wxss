.container {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.course-header {
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  padding: 40rpx 30rpx;
  color: white;
}

.course-title {
  margin-bottom: 20rpx;
}

.course-title .name {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 15rpx;
}

.code-box {
  display: inline-flex;
  align-items: center;
  gap: 15rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.code-box .code {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.code-box .copy-hint {
  font-size: 22rpx;
  opacity: 0.8;
}

.course-meta {
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  background: white;
  margin: -20rpx 30rpx 0;
  border-radius: 15rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stats-bar .stat-item {
  text-align: center;
}

.stats-bar .num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90E2;
}

.stats-bar .label {
  font-size: 24rpx;
  color: #999;
}

.tab-bar {
  display: flex;
  margin: 30rpx;
  background: white;
  border-radius: 15rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  background: #4A90E2;
  color: white;
}

.tab-content {
  padding: 0 30rpx 30rpx;
}

.info-section, .members-section, .action-section {
  background: white;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.info-item {
  margin-bottom: 15rpx;
}

.info-item .label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.member-item {
  background: #F5F5F5;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-name {
  font-size: 26rpx;
  color: #333;
}

.member-id {
  font-size: 22rpx;
  color: #999;
}

.action-btn.primary {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4A90E2;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.assignment-list, .question-list {
  background: white;
  border-radius: 15rpx;
  overflow: hidden;
}

.assignment-item, .question-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.assignment-item:last-child, .question-item:last-child {
  border-bottom: none;
}

.assignment-info .title, .question-content {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.assignment-info .meta {
  font-size: 24rpx;
  color: #999;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.student {
  font-size: 26rpx;
  color: #666;
}

.status-tag {
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-tag.answered, .status-tag.present {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-tag.pending, .status-tag.absent {
  background: #FFF3E0;
  color: #FF9800;
}

.answer-preview {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
}

.answer-teacher {
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: bold;
}

.answer-content {
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
}