<view class="container">
  <view class="header-bar">
    <text class="page-title">我的课程</text>
    <view class="action-btns">
      <view class="action-btn join" bindtap="toggleJoinModal">
        <text>加入课程</text>
      </view>
      <view class="action-btn create" bindtap="toggleCreateModal" wx:if="{{userInfo.role === 'teacher'}}">
        <text>创建课程</text>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="empty" wx:elif="{{courses.length === 0}}">
    <image class="empty-icon" src="/assets/images/empty.png" mode="aspectFit"/>
    <text class="empty-text">暂无课程</text>
    <text class="empty-hint">{{userInfo.role === 'teacher' ? '创建' : '加入'}}一个课程开始吧</text>
  </view>

  <view class="course-list" wx:else>
    <view class="course-card" wx:for="{{courses}}" wx:key="id" data-id="{{item.id}}" bindtap="goToCourseDetail">
      <view class="course-header">
        <text class="course-name">{{item.name}}</text>
        <text class="course-code">{{item.code}}</text>
      </view>
      <view class="course-info">
        <text class="teacher">{{item.teacher_name}}</text>
        <text class="class-time" wx:if="{{item.class_time}}">{{item.class_time}}</text>
      </view>
      <view class="course-desc" wx:if="{{item.description}}">
        <text>{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showCreateModal}}">
    <view class="modal-mask" bindtap="toggleCreateModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">创建课程</text>
        <text class="modal-close" bindtap="toggleCreateModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="label">课程名称 *</text>
          <input class="input" placeholder="请输入课程名称" value="{{newCourse.name}}" bindinput="onCourseNameInput"/>
        </view>
        <view class="form-item">
          <text class="label">课程代码 *</text>
          <input class="input" placeholder="请输入课程代码" value="{{newCourse.code}}" bindinput="onCourseCodeInput"/>
        </view>
        <view class="form-item">
          <text class="label">课程描述</text>
          <textarea class="textarea" placeholder="请输入课程描述" value="{{newCourse.description}}" bindinput="onCourseDescInput"/>
        </view>
        <view class="form-item">
          <text class="label">上课时间</text>
          <input class="input" placeholder="如：周一 8:00-9:40" value="{{newCourse.classTime}}" bindinput="onCourseTimeInput"/>
        </view>
        <view class="form-item">
          <text class="label">上课地点</text>
          <input class="input" placeholder="请输入上课地点" value="{{newCourse.location}}" bindinput="onCourseLocationInput"/>
        </view>
        <button class="submit-btn" bindtap="createCourse">创建</button>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showJoinModal}}">
    <view class="modal-mask" bindtap="toggleJoinModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">加入课程</text>
        <text class="modal-close" bindtap="toggleJoinModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="label">课程代码</text>
          <input class="input" placeholder="请输入课程代码" value="{{joinCode}}" bindinput="onJoinCodeInput"/>
        </view>
        <button class="submit-btn" bindtap="joinCourse">加入</button>
      </view>
    </view>
  </view>
</view>