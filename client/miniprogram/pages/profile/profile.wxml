<view class="container">
  <view class="profile-header">
    <image class="avatar" src="{{userInfo.avatar || '/assets/icons/profile.png'}}"/>
    <view class="user-info">
      <text class="name">{{userInfo.name}}</text>
      <text class="role {{userInfo.role}}">{{userInfo.role === 'teacher' ? '教师' : '学生'}}</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.courses}}</text>
      <text class="stat-label">我的课程</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.assignments}}</text>
      <text class="stat-label">作业</text>
    </view>
  </view>

  <view class="info-section">
    <view class="info-item" wx:if="{{userInfo.studentId}}">
      <text class="label">学号</text>
      <text class="value">{{userInfo.studentId}}</text>
    </view>
    <view class="info-item" wx:if="{{userInfo.phone}}">
      <text class="label">手机号</text>
      <text class="value">{{userInfo.phone}}</text>
    </view>
  </view>

  <view class="action-list">
    <view class="action-item" bindtap="goToCourse">
      <text class="action-text">我的课程</text>
      <text class="arrow">></text>
    </view>
    <view class="action-item" bindtap="goToAssignment">
      <text class="action-text">我的作业</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="logout-btn" bindtap="handleLogout">
    <text>退出登录</text>
  </view>
</view>