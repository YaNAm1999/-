<view class="container" wx:if="{{assignment}}">
  <view class="assignment-header">
    <text class="title">{{assignment.title}}</text>
    <view class="meta">
      <text class="course">{{assignment.course_name}}</text>
      <text class="teacher">{{assignment.teacher_name}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">作业描述</text>
    <text class="content">{{assignment.content || '暂无描述'}}</text>
  </view>

  <view class="section" wx:if="{{assignment.deadline}}">
    <text class="section-title">截止时间</text>
    <text class="deadline">{{assignment.deadline}}</text>
  </view>

  <view class="section" wx:if="{{userInfo.role === 'student'}}">
    <text class="section-title">我的提交</text>
    <view class="my-submission" wx:if="{{mySubmission}}">
      <view class="submission-info">
        <text class="status {{mySubmission.score !== null ? 'graded' : 'pending'}}">
          {{mySubmission.score !== null ? '已评分' : '待评分'}}
        </text>
        <text class="time">提交于: {{mySubmission.submitted_at}}</text>
      </view>
      <text class="submission-content">{{mySubmission.content}}</text>
      <view class="score-section" wx:if="{{mySubmission.score !== null}}">
        <text class="score">得分: {{mySubmission.score}}</text>
        <text class="feedback" wx:if="{{mySubmission.feedback}}">评语: {{mySubmission.feedback}}</text>
      </view>
    </view>
    <view class="no-submission" wx:else>
      <text>尚未提交</text>
      <button class="submit-btn" bindtap="toggleSubmitModal">提交作业</button>
    </view>
  </view>

  <view class="section" wx:if="{{userInfo.role === 'teacher' && submissions.length > 0}}">
    <text class="section-title">学生提交 ({{submissions.length}})</text>
    <view class="submission-list">
      <view class="submission-item" wx:for="{{submissions}}" wx:key="id">
        <view class="submission-header">
          <view class="student-info">
            <text class="name">{{item.name}}</text>
            <text class="student-id" wx:if="{{item.student_id}}">{{item.student_id}}</text>
          </view>
          <view class="submission-status">
            <text class="status {{item.score !== null ? 'graded' : 'pending'}}">
              {{item.score !== null ? '已评分' : '待评分'}}
            </text>
          </view>
        </view>
        <text class="submission-content">{{item.content}}</text>
        <view class="submission-time">
          <text>提交时间: {{item.submitted_at}}</text>
        </view>
        <view class="grade-form">
          <input class="score-input" type="number" placeholder="分数" data-id="{{item.id}}" bindinput="onScoreInput"/>
          <input class="feedback-input" placeholder="评语" data-id="{{item.id}}" bindinput="onFeedbackInput"/>
          <button class="grade-btn" size="mini" data-id="{{item.id}}" bindtap="submitGrade">评分</button>
        </view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showSubmitModal}}">
    <view class="modal-mask" bindtap="toggleSubmitModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">提交作业</text>
        <text class="modal-close" bindtap="toggleSubmitModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="label">提交内容</text>
          <textarea class="textarea" placeholder="请输入作业内容" value="{{submitContent}}" bindinput="onContentInput"/>
        </view>
        <button class="submit-btn" bindtap="submitAssignment">提交</button>
      </view>
    </view>
  </view>
</view>