<view class="container">
  <view class="header-bar">
    <text class="page-title">作业</text>
    <view class="action-btn" bindtap="toggleCreateModal" wx:if="{{userInfo.role === 'teacher'}}">
      <text>发布作业</text>
    </view>
  </view>

  <view class="filter-bar">
    <picker mode="selector" range="{{courses}}" range-key="name" bindchange="onCourseChange">
      <view class="filter-value">
        <text>{{selectedCourseName}}</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="empty" wx:elif="{{assignments.length === 0}}">
    <text>暂无作业</text>
  </view>

  <view class="assignment-list" wx:else>
    <view class="assignment-card" wx:for="{{assignments}}" wx:key="id" data-id="{{item.id}}" bindtap="goToAssignmentDetail">
      <view class="card-header">
        <text class="title">{{item.title}}</text>
        <text class="course-name">{{item.course_name}}</text>
      </view>
      <view class="card-content">
        <text class="desc">{{item.content || '暂无描述'}}</text>
      </view>
      <view class="card-footer">
        <text class="teacher">{{item.teacher_name}}</text>
        <text class="deadline" wx:if="{{item.deadline}}">截止: {{item.deadline}}</text>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showCreateModal}}">
    <view class="modal-mask" bindtap="toggleCreateModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">发布作业</text>
        <text class="modal-close" bindtap="toggleCreateModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="label">选择课程 *</text>
          <picker mode="selector" range="{{courses}}" range-key="name" bindchange="onCourseSelect">
            <view class="picker-value">
              {{newCourseName}}
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="label">作业标题 *</text>
          <input class="input" placeholder="请输入作业标题" value="{{newAssignment.title}}" bindinput="onTitleInput"/>
        </view>
        <view class="form-item">
          <text class="label">作业描述</text>
          <textarea class="textarea" placeholder="请输入作业描述" value="{{newAssignment.content}}" bindinput="onContentInput"/>
        </view>
        <view class="form-item">
          <text class="label">截止时间</text>
          <picker mode="date" bindchange="onDeadlineChange">
            <view class="picker-value">{{newAssignment.deadline || '请选择截止时间'}}</view>
          </picker>
        </view>
        <button class="submit-btn" bindtap="createAssignment">发布</button>
      </view>
    </view>
  </view>
</view>