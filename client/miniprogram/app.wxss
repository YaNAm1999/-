page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 30rpx;
}

.header .logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.header .title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.header .subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.role-selector {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 40rpx;
}

.role-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 50rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.role-btn.active {
  background: #4A90E2;
  color: white;
}

.role-btn .role-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.form {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.form-item .input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #4A90E2;
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.login-btn::after {
  border: none;
}

.footer {
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.footer .link {
  color: #4A90E2;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty .empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty .empty-hint {
  font-size: 26rpx;
  color: #CCC;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #E5E5E5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 50rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4A90E2;
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-top: 30rpx;
}

.submit-btn::after {
  border: none;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  padding: 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  color: #CCC;
}